---

<header class="site-header fixed top-0 z-50 w-full inline-flex flex-col justify-start items-center">
  <!-- stacked blur layers: strongest at top, fading to none at bottom -->
  <div class="blur-stack" aria-hidden="true">
    <span class="blur-layer" style="--blur: 8px; --stops: black 0%, black 10%, transparent 30%;"></span>
    <span class="blur-layer" style="--blur: 4px;  --stops: transparent 0%, black 20%, black 30%, transparent 50%;"></span>
    <span class="blur-layer" style="--blur: 2px;  --stops: transparent 20%, black 40%, black 50%, transparent 70%;"></span>
    <span class="blur-layer" style="--blur: 1px;  --stops: transparent 40%, black 60%, black 70%, transparent 90%;"></span>
    <span class="blur-layer" style="--blur: 0px;  --stops: transparent 60%, black 80%, transparent 100%;"></span>
  </div>

  <div class="self-stretch p-8 bg-gradient-to-b from-white/60 to-white/0 inline-flex flex-col relative z-10">
    <div class="self-stretch h-14 rounded-lg inline-flex justify-center items-center gap-2">
      <div class="mix-blend-difference justify-center text-neutral text-3xl font-bold font-antonio uppercase">
        Nadeera Udumullage
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
  }

  .blur-stack {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .blur-layer {
    position: absolute;
    inset: 0;
    -webkit-backdrop-filter: blur(var(--blur));
    backdrop-filter: blur(var(--blur));
    -webkit-mask-image: linear-gradient(to bottom, var(--stops));
    mask-image: linear-gradient(to bottom, var(--stops));
  }
</style>