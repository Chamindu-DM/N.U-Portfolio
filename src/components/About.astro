---
import Me from "../assets/Nadeera_Udumullage.jpg";
---

<section
    class="w-full px-8 py-24 bg-white flex flex-col justify-center items-center"
>
    <div
        class="w-full px-8 md:px-16 flex flex-col justify-start items-center gap-16"
    >
        <div
            class="w-full text-black text-6xl md:text-7xl font-normal font-helvetica capitalize leading-[80px]"
        >
            About.
        </div>

        <!-- Content Split (Image on Left, Text on Right) -->
        <div
            class="w-full flex flex-col lg:flex-row justify-between items-center gap-16 lg:gap-8"
        >
            <!-- Left: Scattered Image Gallery -->
            <!-- We use 'relative' on the container and 'absolute' on the small background images to scatter them behind the main portrait -->
            <div
                class="relative flex justify-center items-center w-80 h-80 md:w-96 md:h-96"
            >
                <!-- Small Image 1 (Top Left) -->
                <!--<img class="absolute -left-12 -top-8 w-48 h-48 rotate-[4deg] rounded-2xl shadow-[0px_8px_20px_rgba(0,0,0,0.15)] transition-transform hover:scale-105 hover:rotate-0 hover:z-20 duration-300" src="https://placehold.co/200x200" alt="Gallery image 1" />
                -->
                <!-- Small Image 2 (Top Right) -->
                <!--<img class="absolute -right-8 -top-2 w-48 h-48 rotate-[-4deg] rounded-2xl shadow-[0px_8px_20px_rgba(0,0,0,0.15)] transition-transform hover:scale-105 hover:rotate-0 hover:z-20 duration-300" src="https://placehold.co/200x200" alt="Gallery image 2" />
                -->
                <!-- Small Empty Frame (Bottom Left) -->
                <!--<div class="absolute -bottom-8 -left-4 w-48 h-48 rotate-[4deg] bg-white rounded-2xl shadow-[0px_8px_20px_rgba(0,0,0,0.15)] transition-transform hover:scale-105 hover:rotate-0 hover:z-20 duration-300"></div>
                -->
                <!-- Main Portrait (Center & Front) -->
                <img
                    class="relative w-80 h-80 md:w-100 md:h-100 rounded-2xl shadow-[0px_12px_40px_rgba(0,0,0,0.2)] z-10"
                    src={Me.src}
                    alt="Nadeera Udumullage Portrait"
                />
            </div>

            <!-- Right: Text Content -->
            <div
                class="flex-1 max-w-[680px] inline-flex flex-col justify-center items-center gap-6 tracking-wide leading-[20px]"
            >
                <div class="self-stretch text-justify justify-center">
                    <span
                        class="text-black text-lg font-light font-['Helvetica_Neue']"
                        >I'm
                    </span><span
                        class="text-black text-lg font-medium font-['Helvetica_Neue']"
                        >Nadeera Udumullage</span
                    ><span
                        class="text-black text-lg font-light font-['Helvetica_Neue']"
                        >, a Manufacturing and Industrial Engineering
                        undergraduate at the University of Peradeniya. My
                        interests include lean manufacturing, simulation
                        modeling, and operations research, with a focus on
                        improving productivity and designing efficient,
                        data-driven systems.<br /><br />Research done apart from
                        real problems loses half its value, that's why I keep
                        one foot in industry, through internships and industry
                        projects that keep the work grounded and actually
                        useful.<br /><br />If you're sitting on an inefficiency
                        on the floor, a process that keeps breaking, or a
                        decision that needs data behind it, that's exactly the
                        kind of problem I want to dig into. Feel free to get in
                        touch.</span>
                </div>
                <div
                    class="self-stretch justify-start text-[#FF4F00] text-2xl font-normal italic font-['DM_Serif_Display']"
                >
                    “A permanent corporate role isn't the goal.”
                </div>
            </div>
        </div>
    </div>
</section>
