---
import EnvelopeIcon from '../assets/Envelope.svg';
import LinkedinIcon from '../assets/LinkedinLogo.svg';
import MapPinIcon from '../assets/MapPin.svg';
import CaretDownIcon from '../assets/CaretDown.svg';
import PaperPlaneIcon from '../assets/PaperPlaneRight.svg';
---

<div class="w-full px-4 md:px-8 pt-12 md:pt-24 pb-11 bg-[#FF4F00] inline-flex flex-col justify-center items-center gap-2">
    <div class="self-stretch px-4 md:px-16 flex flex-col justify-start items-center gap-8 md:gap-16">
        <div class="typewriter-title min-h-[80px] self-stretch justify-start text-white text-5xl md:text-7xl font-normal font-['Helvetica_Neue'] capitalize leading-[60px] md:leading-[80px]">Contact.</div>
        <div class="self-stretch flex flex-col lg:flex-row justify-start items-stretch gap-10">
            <div class="w-full lg:flex-1 inline-flex flex-col justify-start items-start gap-10">
                <div class="self-stretch italic justify-start text-white text-3xl md:text-4xl font-normal font-['DM_Serif_Display']">Let's see if there's something worth working on together.</div>
                <div class="self-stretch flex flex-col justify-start items-start">
                    
                    <!-- Email Card -->
                    <div class="self-stretch p-6 outline outline-1 outline-offset-[-0.50px] outline-white flex flex-col justify-start items-center gap-4">
                        <div class="self-stretch inline-flex justify-start items-center gap-2">
                            <img src={EnvelopeIcon.src} alt="Email" class="size-6 brightness-0 invert" />
                            <div class="flex-1 text-white text-2xl font-medium font-['Helvetica_Neue'] capitalize">email</div>
                        </div>
                        <a href="mailto:sumudunadeera01@gmail.com" class="self-stretch text-white text-lg font-normal font-['Helvetica_Neue'] underline hover:text-gray-200 transition-colors">sumudunadeera01@gmail.com</a>
                    </div>
                    
                    <!-- LinkedIn Card -->
                    <div class="self-stretch p-6 outline outline-1 outline-offset-[-0.50px] outline-white flex flex-col justify-start items-center gap-4">
                        <div class="self-stretch inline-flex justify-start items-center gap-2">
                            <img src={LinkedinIcon.src} alt="LinkedIn" class="size-6 brightness-0 invert" />
                            <div class="flex-1 text-white text-2xl font-medium font-['Helvetica_Neue'] capitalize">LinkedIn</div>
                        </div>
                        <a href="https://www.linkedin.com/in/nxdeera/" target="_blank" class="self-stretch text-white text-lg font-normal font-['Helvetica_Neue'] underline hover:text-gray-200 transition-colors">https://www.linkedin.com/in/nxdeera/</a>
                    </div>
                    
                    <!-- Location Card -->
                    <div class="self-stretch p-6 outline outline-1 outline-offset-[-0.50px] outline-white flex flex-col justify-start items-center gap-4">
                        <div class="self-stretch inline-flex justify-start items-center gap-2">
                            <img src={MapPinIcon.src} alt="Location" class="size-6 brightness-0 invert" />
                            <div class="flex-1 text-white text-2xl font-medium font-['Helvetica_Neue'] capitalize">Based in</div>
                        </div>
                        <div class="self-stretch text-white text-lg font-normal font-['Helvetica_Neue']">Colombo, Sri Lanka</div>
                    </div>

                </div>
            </div>
            
            <!-- Contact Form -->
            <form class="w-full lg:flex-1 self-stretch p-4 bg-white flex flex-col justify-start items-stretch gap-4 shadow-sm">
                
                <!-- Name -->
                <div class="flex flex-col">
                    <label for="name" class="text-neutral-700 text-sm font-light font-['Helvetica_Neue']">Name</label>
                    <input type="text" id="name" name="name" class="w-full bg-transparent border-b border-black/10 text-black py-2 focus:outline-none focus:border-[#FF4F00] transition-colors" />
                </div>
                
                <!-- Email -->
                <div class="flex flex-col">
                    <label for="email" class="text-neutral-700 text-sm font-light font-['Helvetica_Neue']">Email</label>
                    <input type="email" id="email" name="email" class="w-full bg-transparent border-b border-black/10 text-black py-2 focus:outline-none focus:border-[#FF4F00] transition-colors" />
                </div>
                
                <!-- Topic -->
                <div class="flex flex-col">
                    <label for="topic" class="text-neutral-700 text-sm font-light font-['Helvetica_Neue']">Topic</label>
                    <div class="relative">
                        <select id="topic" name="topic" class="w-full bg-transparent border-b border-black/10 text-black py-2 appearance-none focus:outline-none focus:border-[#FF4F00] transition-colors cursor-pointer rounded-none">
                            <option value="PhD / research collaboration">PhD / research collaboration</option>
                            <option value="Industry project">Industry project</option>
                            <option value="Speaking / teaching">Speaking / teaching</option>
                            <option value="General inquiry">General inquiry</option>
                            <option value="Other">Other</option>
                        </select>
                        <img src={CaretDownIcon.src} alt="" class="size-4 absolute right-0 top-1/2 -translate-y-1/2 pointer-events-none opacity-50" />
                    </div>
                </div>
                
                <!-- Message -->
                <div class="flex-1 flex flex-col gap-2 min-h-[120px]">
                    <label for="message" class="text-neutral-700 text-sm font-light font-['Helvetica_Neue']">Message</label>
                    <textarea id="message" name="message" class="flex-1 w-full bg-transparent border border-black/10 text-black p-3 resize-none focus:outline-none focus:border-[#FF4F00] transition-colors"></textarea>
                </div>
                
                <!-- Submit Button -->
                <button type="submit" class="w-full p-4 bg-[#FF4F00] hover:bg-[#e64600] transition-colors inline-flex justify-center items-center gap-2 cursor-pointer group">
                    <span class="text-white text-lg font-medium font-['Helvetica_Neue']">Send message</span>
                    <img src={PaperPlaneIcon.src} alt="" class="size-6 brightness-0 invert group-hover:translate-x-1 transition-transform" />
                </button>
            </form>
        </div>
        <div class="text-center text-white text-xs font-normal font-['Helvetica_Neue']">® All rights reserved 2026 ● Nadeera Udumullage</div>
    </div>
</div>