---
import Header from "../components/Header.astro"
import ScrollBar from "../components/ScrollBar.astro"
import "../styles/global.css"

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const { 
	title = "Nadeera Udumullage | Manufacturing and Industrial Engineering", 
	description = "Nadeera Udumullage is a Manufacturing and Industrial Engineering undergraduate at the University of Peradeniya, focusing on lean manufacturing, simulation modeling, and operations research.",
	image = "/favicon.svg"
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		
		<!-- SEO Meta Tags -->
		<meta name="description" content={description} />
		<meta name="keywords" content="Nadeera Udumullage, Manufacturing Engineering, Industrial Engineering, Lean Manufacturing, Simulation Modeling, Operations Research, University of Peradeniya, Sri Lanka, Portfolio" />
		<meta name="author" content="Nadeera Udumullage" />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, Astro.url)} />
		
		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL(image, Astro.url)} />
		
		<link rel="canonical" href={Astro.url} />
		<!-- Lenis for smooth momentum scrolling -->
		<script is:inline src="https://unpkg.com/lenis@1.1.18/dist/lenis.min.js"></script>
	</head>
	<body class="bg-white">
		<Header/>
		<slot />
		<ScrollBar/>
	</body>
</html>

<style is:global>
	.typewriter-title::after {
		content: '|';
		color: #FF4F00;
		animation: blink 1s step-end infinite;
	}
	.typewriter-title.typing-complete::after {
		display: none;
	}
	@keyframes blink {
		0%, 100% { opacity: 1; }
		50% { opacity: 0; }
	}
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { TextPlugin } from "gsap/TextPlugin";

    gsap.registerPlugin(ScrollTrigger, TextPlugin);

    document.addEventListener('DOMContentLoaded', ()=> {
        // Initialize Lenis for smooth scrolling
        const lenis = new window.Lenis();
        
        // Sync Lenis with GSAP ScrollTrigger
        lenis.on('scroll', ScrollTrigger.update);
        
        // Tell GSAP to use Lenis's raf (requestAnimationFrame)
        gsap.ticker.add((time)=>{
            lenis.raf(time * 1000);
        });
        
        // Turn off GSAP's lag smoothing to avoid conflicts with Lenis
        gsap.ticker.lagSmoothing(0);

        const titles = document.querySelectorAll('.typewriter-title');
        
        titles.forEach(title => {
            const originalText = title.textContent?.trim() || "";
            // Clear the text initially so it's ready to type
            title.textContent = "";
            
            gsap.to(title, {
                text: originalText,
                // Adjust duration based on text length for consistent typing speed
                duration: Math.max(1, originalText.length * 0.05),
                ease: "none",
                onStart: () => title.classList.remove('typing-complete'),
                onComplete: () => title.classList.add('typing-complete'),
                onReverseComplete: () => title.classList.remove('typing-complete'),
                scrollTrigger: {
                    trigger: title,
                    start: "top 85%", // Start typing when title is 15% from bottom of screen
                    toggleActions: "play none none reverse" // Type in on scroll down, un-type on scroll up
                }
            });
        });
    });
</script>
